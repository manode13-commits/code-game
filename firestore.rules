rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players collection for game leaderboards, progress and student certificates
    match /players/{playerId} {
      allow read, write: if true;
    }
    
    // Certificates collection for public verification and retroactive downloads
    match /certificates/{certId} {
      allow read, write: if true;
    }

    // Health check and connection test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // General fallback for game collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

